# Copy to .env and adjust. Everything has a safe default; the engine runs with none set.

# Database (SQLite by default; use postgresql://... in production)
DATABASE_URL=sqlite:///./veloxi.db

# Admin API token, sent as the X-Admin-Token header. Empty = admin API locked.
ADMIN_TOKEN=

# Background ingestion + URL validation. Off by default so the engine boots clean and offline.
INGEST_ENABLED=false

# Optional: Apify actor sources
APIFY_TOKEN=

# Optional LLM refinement. Empty = deterministic heuristic, no key needed.
# Set to one of: anthropic | openai | gemini, and provide the matching key.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
